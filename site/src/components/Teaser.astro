---
// A live miniature of the main window, true to the app as it is now
// (docs/superpowers/specs/2026-11-02-site-design.md, "The teaser").
import Icon from './Icon.astro';
import { STONE } from '../scripts/teaser/notes';
---

<div class="win" data-teaser aria-hidden="true">
  {
    ['breath', 'sun', 'quarter', 'wind', 'stone', 'mandala', 'search', 'chevron', 'hourglass', 'carve', 'restore'].map((n) => (
      <template data-icon={n}>
        <Icon name={n} size={14} />
      </template>
    ))
  }
  <div class="tb">
    <div class="start"><span class="dots"><i></i><i></i><i></i></span><span class="hg mono"><Icon name="hourglass" size={14} />25</span></div>
    <div class="crumbs"><Icon name="mandala" size={15} class="mark" /><span>notes</span><span class="sep">/</span><span data-crumb>sand</span><span class="sep">/</span><span data-crumb-title>Low tide</span></div>
    <div class="actions"><span class="pill"><Icon name="mandala" size={14} />Mandala <span class="mono key">⌘M</span></span><span class="pill"><Icon name="search" size={14} />Search <span class="mono key">⌘P</span></span></div>
  </div>
  <div class="cols">
    <nav class="rail l">
      <div class="rh"><span class="name stone-t"><Icon name="stone" size={15} /><b>Stone</b></span><span class="count mono" data-kept>4 kept</span></div>
      {
        STONE.map((g) => (
          <div class="group">
            {g.folder && (
              <div class="folder">
                <Icon name="chevron" size={14} />
                {g.folder}
              </div>
            )}
            {g.folder === 'poems' && <div class="note landing" data-landing>Low tide</div>}
            {g.notes.map((n) => (
              <div class:list={['note', { loose: !g.folder }]}>{n}</div>
            ))}
          </div>
        ))
      }
    </nav>
    <section class="page" data-page>
      <div class="head" data-head>
        <div class="life mono" data-life>
          <svg width="22" height="22" viewBox="-11 -11 22 22"><circle r="9" fill="none" stroke="var(--line)" stroke-width="2"></circle><circle data-ring r="9" fill="none" stroke="var(--sand)" stroke-width="2" stroke-linecap="round" stroke-dasharray="0 56.5" transform="rotate(-90)"></circle></svg>
          <span data-life-mark></span><span data-life-left></span>
        </div>
        <div class="carving" data-carving hidden><svg class="rune" width="16" height="16" viewBox="-12 -12 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" data-carving-rune></svg><span class="serif" data-carving-text></span></div>
        <div class="do" data-do>
          <span class="pill" data-letgo><span class="fill"></span><Icon name="wind" size={14} />Let go</span>
          <span class="pill stone" data-keep><span class="fill"></span><Icon name="stone" size={14} />Set in stone <span class="mono key">⌘↵</span></span>
        </div>
      </div>
      <article data-article><h3 class="serif" data-title></h3><p class="serif" data-text></p></article>
      <div class="toast" data-toast><span data-toast-text></span><span class="pill sand"><Icon name="restore" size={14} />Restore</span></div>
    </section>
    <aside class="rail r">
      <div class="rh"><span class="count mono" data-count></span><span class="name sand-t"><b>Sand</b><span class="grains"><i></i><i></i><i></i></span></span></div>
      <div class="new"><span>Breath<small class="breath"><Icon name="breath" size={14} /></small></span><span>Sun<small class="mono"><Icon name="sun" size={14} class="sun" />24h</small></span><span>Moon<small class="moon"><Icon name="quarter" size={14} /></small></span></div>
      <div class="list" data-list></div>
    </aside>
  </div>
  <div class="card" data-card>
    <p class="eyebrow">Set in stone</p>
    <h4 class="serif">Low tide</h4>
    <p class="why serif" data-why></p>
    <svg class="ring" width="112" height="112" viewBox="-66 -66 132 132">
      <circle r="60" fill="var(--stone-ground)" stroke="#2c3439" stroke-width="3"></circle>
      <circle data-card-ring r="60" fill="none" stroke="var(--stone)" stroke-width="3" stroke-linecap="round" stroke-dasharray="0 377" transform="rotate(-90)"></circle>
      <g transform="scale(3.6)" fill="none" stroke-linecap="round" stroke-linejoin="round" data-card-rune></g>
    </svg>
    <p class="hint mono">Hold the ring</p>
  </div>
  <div class="closing" data-closing>
    <h4 class="serif" data-closing-title></h4>
    <ul data-closing-list></ul>
    <div class="leave">
      <span class="pill large"><Icon name="back" size={14} />Stay</span>
      <span class="pill sand large" data-close><span class="fill"></span><Icon name="wind" size={14} />Close</span>
    </div>
  </div>
</div>

<script>
  import { runTeaser } from '../scripts/teaser/run';
  let stop: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    stop?.();
    const root = document.querySelector<HTMLElement>('[data-teaser]');
    stop = root ? runTeaser(root) : null;
  });
  document.addEventListener('astro:before-swap', () => {
    stop?.();
    stop = null;
  });
</script>

<style>
  .win {
    position: relative;
    width: min(1060px, 100%);
    height: 520px;
    border-radius: 12px;
    background: var(--ground);
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.06),
      0 40px 120px -30px rgb(0 0 0 / 0.9);
    user-select: none;
    font-size: 13px;
  }
  .win :global(svg) {
    flex-shrink: 0;
  }
  .tb {
    height: 44px;
    background: var(--rail);
    border-bottom: 1px solid var(--line);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 12px;
  }
  .start {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .dots {
    display: flex;
    gap: 7px;
  }
  .dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--line);
  }
  .hg {
    display: flex;
    align-items: center;
    gap: 5px;
    color: var(--dust);
    font-size: 11px;
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ash);
    font-size: 12px;
  }
  .crumbs :global(.mark) {
    color: var(--stone);
  }
  .sep {
    color: var(--dust);
  }
  .actions {
    justify-self: end;
    display: flex;
    gap: 6px;
  }
  .tb .pill {
    height: 26px;
    padding: 0 10px;
    font-size: 12px;
    cursor: default;
  }
  .key {
    font-size: 11px;
    color: var(--dust);
  }
  .cols {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr) 230px;
    height: calc(100% - 44px);
    transition: opacity 800ms var(--ease);
  }
  .rail {
    background: var(--rail);
    padding: 18px 14px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    overflow: hidden;
    min-width: 0;
  }
  .rail.l {
    border-right: 1px solid var(--line);
  }
  .rail.r {
    border-left: 1px solid var(--line);
  }
  .rh {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 20px;
  }
  .name {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .name b {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    /* Trimmed to the capitals, so the mark beside it centres on the letters. */
    text-box: trim-both cap alphabetic;
  }
  .stone-t {
    color: var(--stone);
  }
  .stone-t :global(svg) {
    /* The stone is drawn low in its box (y 5 to 13 of 16): lift it to the letters. */
    transform: translateY(-1px);
  }
  .sand-t {
    color: var(--sand);
  }
  .count {
    font-size: 12px;
    color: var(--dust);
  }
  .grains {
    display: flex;
    gap: 2px;
  }
  .grains i {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--sand);
  }
  .grains i:nth-child(2) {
    opacity: 0.6;
  }
  .grains i:nth-child(3) {
    opacity: 0.3;
  }
  .group {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .folder {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 8px 4px 4px;
    color: var(--ash);
    font-size: 12px;
  }
  .folder :global(svg) {
    color: var(--dust);
  }
  .note {
    padding: 6px 8px 6px 22px;
    border-radius: 6px;
    color: var(--bone);
    transition:
      background var(--settle) var(--ease),
      color var(--settle) var(--ease);
  }
  .note.loose {
    padding-left: 8px;
  }
  .note.landing {
    display: none;
  }
  .note.landing:global(.here) {
    display: block;
  }
  .note:global(.on) {
    background: var(--stone-ground);
    color: var(--stone);
  }
  .new {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }
  .new > span {
    height: 44px;
    border-radius: 10px;
    border: 1px solid var(--line);
    color: var(--ash);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
  }
  .new small {
    display: flex;
    gap: 3px;
    align-items: center;
    font-size: 11px;
    opacity: 0.75;
  }
  .breath {
    color: var(--life-breath);
  }
  .new :global(.sun) {
    color: var(--life-sun);
  }
  .moon {
    color: var(--life-moon);
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .list :global(.grain) {
    position: relative;
    padding: 10px;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    overflow: hidden;
    transition: background var(--settle) var(--ease);
  }
  .list :global(.grain.on) {
    background: var(--sand-ground);
  }
  .list :global(.t) {
    line-height: 1.35;
    color: var(--bone);
  }
  .list :global(.m) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    color: var(--ash);
  }
  .list :global(.b) {
    height: 2px;
    background: var(--line);
    border-radius: 2px;
    overflow: hidden;
  }
  .list :global(.b i) {
    display: block;
    height: 2px;
    margin-left: auto;
    background: var(--sand);
    transition: width var(--settle) var(--ease);
  }
  .list :global(.grain.low .b i) {
    background: var(--vermilion);
  }
  .list :global(.hold) {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    background: rgb(169 188 198 / 0.16);
    pointer-events: none;
  }
  .list :global(.hold.go) {
    width: 100%;
    transition: width 1000ms linear;
  }
  .list :global(.hold.letgo) {
    background: rgb(162 156 146 / 0.16);
  }
  .page {
    position: relative;
    overflow: hidden;
    min-width: 0;
  }
  .head {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 14px 24px;
    height: 60px;
  }
  .life,
  .carving {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
  }
  .life {
    color: var(--sand);
  }
  .life [data-life-mark] {
    display: flex;
  }
  .life [data-life-left] {
    white-space: nowrap;
  }
  .carving {
    color: var(--stone);
  }
  .carving .serif {
    font-style: italic;
    font-size: 15px;
  }
  .carving[hidden],
  .life[hidden],
  .do[hidden] {
    display: none;
  }
  .carving .serif {
    white-space: nowrap;
  }
  /* The keep card lies over a dimmed page, as the app's dialog does. */
  .page::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(14 13 16 / 0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--settle) var(--ease);
  }
  .win:global(.keeping) .page::after {
    opacity: 1;
  }
  .do {
    display: flex;
    gap: 8px;
    transition: opacity var(--settle) var(--ease);
  }
  .do .pill {
    position: relative;
    overflow: hidden;
    cursor: default;
  }
  .do .pill > :global(*:not(.fill)) {
    position: relative;
  }
  .fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    background: rgb(162 156 146 / 0.2);
  }
  .pill.stone .fill {
    background: rgb(169 188 198 / 0.24);
  }
  .fill:global(.go) {
    width: 100%;
    transition: width 1000ms linear;
  }
  article {
    max-width: 520px;
    margin: 0 auto;
    padding: 18px 24px;
    transition: opacity 240ms var(--ease);
  }
  article h3 {
    margin: 0 0 18px;
    font-size: 40px;
    font-weight: 400;
    line-height: 1.15;
  }
  article p {
    margin: 0;
    min-height: 100px;
    font-size: 19px;
    line-height: 1.65;
    white-space: pre-line;
  }
  .page :global(.caret) {
    display: inline-block;
    width: 1.5px;
    height: 1.05em;
    margin-left: 1px;
    vertical-align: -2px;
    background: var(--sand);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .toast {
    position: absolute;
    left: 50%;
    bottom: 22px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 8px 8px 16px;
    border-radius: 999px;
    background: var(--raised);
    box-shadow: 0 0 0 1px var(--line);
    color: var(--parchment);
    font-size: 12px;
    white-space: nowrap;
    opacity: 0;
    transform: translate(-50%, 12px);
    transition:
      opacity 320ms var(--ease),
      transform 320ms var(--ease);
  }
  .toast:global(.on) {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .toast .pill {
    height: 26px;
    padding: 0 10px;
    font-size: 12px;
  }
  .card {
    position: absolute;
    left: 50%;
    top: 54%;
    width: 300px;
    padding: 22px 24px 18px;
    border-radius: 16px;
    background: var(--raised);
    box-shadow:
      0 0 0 1px var(--line),
      0 30px 80px -20px rgb(0 0 0 / 0.8);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
    opacity: 0;
    transform: translate(-50%, -46%) scale(0.98);
    pointer-events: none;
    transition:
      opacity var(--settle) var(--ease),
      transform var(--settle) var(--ease);
  }
  .card:global(.on) {
    opacity: 1;
    transform: translate(-50%, -50%);
  }
  .card .eyebrow {
    margin: 0;
    color: var(--stone);
  }
  .card h4 {
    margin: 0;
    font-size: 24px;
    font-weight: 400;
  }
  .why {
    margin: 0 0 8px;
    text-wrap: balance;
    min-height: 1.4em;
    color: var(--parchment);
    font-style: italic;
    font-size: 15px;
  }
  .ring :global(.ghost) {
    stroke: var(--stone);
    stroke-width: 0.5;
    opacity: 0.22;
  }
  /* As the app's keep card: the rune glows in, brightening, then is painted on. */
  .ring :global(.glow) {
    stroke: color-mix(in srgb, var(--bone) calc(var(--glow, 0) * 100%), var(--stone));
    stroke-width: 1.15;
    opacity: calc(var(--glow, 0) * 0.85);
    filter: drop-shadow(0 0 calc(var(--glow, 0) * 3px) var(--stone));
  }
  .ring :global(.paint) {
    stroke: var(--stone);
    stroke-width: 1.3;
    clip-path: inset(-20% 100% -20% -20%);
    transition: clip-path 450ms var(--ease);
  }
  .ring :global(.paint.painted) {
    clip-path: inset(-20% -20% -20% -20%);
  }
  .hint {
    margin: 4px 0 0;
    color: var(--dust);
    font-size: 11px;
  }
  /* Closing, as the app's closing screen: the window gives way to the night,
     the visit's breaths are listed, and they blur and fade as they leave. */
  .win:global(.closed) .cols {
    opacity: 0;
  }
  .closing {
    position: absolute;
    inset: 44px 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 26px;
    padding: 32px 24px;
    background: var(--night);
    opacity: 0;
    pointer-events: none;
    transition: opacity 800ms var(--ease);
  }
  .win:global(.closed) .closing {
    opacity: 1;
  }
  .closing h4 {
    margin: 0;
    font-size: 30px;
    font-weight: 400;
    text-align: center;
    text-wrap: balance;
  }
  .closing ul {
    list-style: none;
    margin: 0;
    padding: 0;
    width: min(420px, 100%);
  }
  .closing :global(li) {
    padding: 16px 20px;
    border: 1px solid var(--line);
    border-radius: 14px;
    font-size: 17px;
    transition:
      opacity 900ms var(--ease) calc(var(--i) * 80ms),
      letter-spacing 900ms var(--ease) calc(var(--i) * 80ms),
      filter 900ms var(--ease) calc(var(--i) * 80ms);
  }
  .win:global(.leaving) .closing :global(li) {
    opacity: 0;
    letter-spacing: 0.2em;
    filter: blur(2px);
  }
  .closing h4,
  .leave {
    transition: opacity 600ms var(--ease);
  }
  .win:global(.leaving) .closing h4,
  .win:global(.leaving) .leave {
    opacity: 0;
  }
  .leave {
    display: flex;
    gap: 12px;
  }
  .leave .pill {
    position: relative;
    overflow: hidden;
    cursor: default;
  }
  .leave .pill > :global(*:not(.fill)) {
    position: relative;
  }
  .pill.sand .fill {
    background: rgb(217 174 108 / 0.24);
  }

  /* Narrow: only the two rails, mirrored; the holds fill on the rows. */
  @media (max-width: 820px) {
    .win {
      height: 470px;
    }
    .tb {
      grid-template-columns: auto 1fr auto;
      height: 38px;
    }
    .actions,
    .hg {
      display: none;
    }
    .crumbs {
      justify-content: center;
    }
    .crumbs > :nth-last-child(-n + 2) {
      display: none;
    }
    .cols {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      height: calc(100% - 38px);
    }
    .page {
      display: none;
    }
    /* The loop starts on the page, as a note is written; then the rails show. */
    .win:global(.note-first) .cols {
      grid-template-columns: minmax(0, 1fr);
    }
    .win:global(.note-first) .rail {
      display: none;
    }
    .win:global(.note-first) .page {
      display: block;
    }
    .head {
      padding: 12px 16px;
    }
    .do .key {
      display: none;
    }
    article {
      padding: 14px 16px;
    }
    article h3 {
      font-size: 30px;
    }
    article p {
      font-size: 17px;
    }
    .closing {
      inset: 38px 0 0;
      gap: 20px;
    }
    .closing h4 {
      font-size: 22px;
    }
    .rail {
      padding: 16px 10px;
    }
    .new {
      display: none;
    }
    .group:last-child {
      display: none;
    }
    .note {
      padding-left: 18px;
    }
    .card {
      top: 50%;
      width: min(260px, 86%);
    }
  }
  @media (max-width: 520px) {
    .rh .count {
      display: none;
    }
    /* The ring and the lifespan say enough; the pills keep their words. */
    .life [data-life-left] {
      display: none;
    }
    .head {
      gap: 8px;
    }
    .do {
      gap: 6px;
    }
    .do .pill {
      padding: 0 10px;
    }
    .list :global(.grain) {
      padding: 8px;
    }
    .list :global(.t),
    .note {
      font-size: 12px;
    }
  }
</style>
