---
// An app icon, drawn from src/components/Icon.svelte (see lib/icons.ts).
import { icon } from '../lib/icons';

interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 16, class: className } = Astro.props;
const inner = icon(name);
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
/>
