---
// The docs explorer: the docs on the left, the page between, this page's
// headings on the right (stone, page, sand, as in the app).
import Site from '../../layouts/Site.astro';
import TopBar from '../../components/TopBar.astro';
import DocsRail from '../../components/DocsRail.astro';
import OnThisPage from '../../components/OnThisPage.astro';
import DocNav from '../../components/DocNav.astro';
import Icon from '../../components/Icon.astro';
import SearchSheet from '../../components/SearchSheet.astro';
import { PAGES, checkPages, headingsOf, repoFiles, type Page } from '../../lib/docs';
import { renderPage } from '../../lib/markdown';

export async function getStaticPaths() {
  const files = repoFiles();
  checkPages(files, headingsOf);
  return Promise.all(PAGES.map(async (page) => ({ params: { slug: page.slug }, props: { page, rendered: await renderPage(page, files) } })));
}

interface Props {
  page: Page;
  rendered: Awaited<ReturnType<typeof renderPage>>;
}
const { page, rendered } = Astro.props;
const description = rendered.lede?.replace(/<[^>]+>/g, '') ?? `${page.title}: from Mandala's docs.`;
---

<Site title={page.title} description={description}>
  <TopBar search>
    <button slot="search" class="find" type="button" data-open-search>
      <Icon name="search" size={15} />
      <span>Search the docs</span>
      <span class="key mono" data-key>⌘K</span>
    </button>
    <button slot="menu" class="pill menu" type="button" data-open-docs aria-haspopup="dialog">
      <Icon name="pane-left" size={15} />Docs
    </button>
  </TopBar>
  <div class="cols">
    <aside class="rail left" data-pagefind-ignore transition:persist="docs-rail">
      <DocsRail slug={page.slug} />
    </aside>
    <main transition:animate="fade">
      <article data-pagefind-body>
        <p class="eyebrow where">{page.group}</p>
        <h1 class="serif">{page.title}</h1>
        {rendered.lede && <p class="lede serif" set:html={rendered.lede} />}
        <div class="prose" set:html={rendered.html} />
        <DocNav page={page} />
      </article>
    </main>
    <aside class="rail right" data-pagefind-ignore>
      <OnThisPage headings={rendered.headings} />
    </aside>
  </div>
  <SearchSheet />
  <dialog class="sheet" data-docs-sheet aria-label="Docs">
    <DocsRail slug={page.slug} />
  </dialog>
</Site>

<script>
  const bind = () => {
    const sheet = document.querySelector<HTMLDialogElement>('[data-docs-sheet]');
    document.querySelector('[data-open-docs]')?.addEventListener('click', () => sheet?.showModal());
    sheet?.addEventListener('click', (e) => {
      if (e.target === sheet || (e.target as Element).closest('a')) sheet.close();
    });
    const key = document.querySelector('[data-key]');
    if (key && !/Mac|iPhone|iPad/.test(navigator.platform)) key.textContent = 'Ctrl K';
  };
  document.addEventListener('astro:page-load', bind);
</script>

<style>
  .find {
    justify-self: center;
    width: min(420px, 100%);
    height: 32px;
    padding: 0 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    border-radius: var(--pill);
    border: 1px solid var(--line);
    background: transparent;
    color: var(--dust);
    font: inherit;
    cursor: pointer;
    transition:
      border-color var(--quick) var(--ease),
      color var(--quick) var(--ease);
  }
  .find:hover {
    border-color: var(--line-strong);
    color: var(--ash);
  }
  .find .key {
    margin-left: auto;
    font-size: 11px;
  }
  .menu {
    display: none;
  }
  .cols {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr) 260px;
    min-height: calc(100vh - 52px);
    background: var(--ground);
  }
  .rail {
    position: sticky;
    top: 52px;
    height: calc(100vh - 52px);
    overflow-y: auto;
    padding: 26px 16px;
  }
  .left {
    background: var(--rail);
    border-right: 1px solid var(--line);
  }
  .right {
    border-left: 1px solid var(--line);
  }
  main {
    min-width: 0;
    padding: 56px 48px 120px;
    display: flex;
    justify-content: center;
  }
  article {
    width: 100%;
    max-width: 680px;
    min-width: 0;
  }
  .where {
    margin: 0 0 14px;
  }
  h1 {
    margin: 0 0 14px;
    font-weight: 400;
    font-size: 42px;
    line-height: 1.15;
  }
  .lede {
    margin: 0 0 32px;
    font-size: 20px;
    line-height: 1.6;
    color: var(--parchment);
    text-wrap: pretty;
  }
  .lede :global(strong) {
    color: var(--bone);
    font-weight: 500;
  }

  /* The doc's own text: prose in the serif, tables and code in the window's type. */
  .prose {
    overflow-wrap: break-word;
  }
  .prose :global(h2) {
    margin: 52px 0 14px;
    font: 400 26px/1.3 var(--serif);
    scroll-margin-top: 80px;
  }
  .prose :global(h3) {
    margin: 36px 0 10px;
    font: 500 15px/1.4 var(--sans);
    color: var(--bone);
    scroll-margin-top: 80px;
  }
  .prose :global(p),
  .prose :global(li) {
    font: 400 18px/1.7 var(--serif);
    color: var(--parchment);
  }
  .prose :global(p) {
    margin: 0 0 16px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 18px;
    padding-left: 22px;
  }
  .prose :global(li) {
    margin: 4px 0;
  }
  .prose :global(li > ul),
  .prose :global(li > ol) {
    margin: 4px 0 0;
  }
  .prose :global(strong) {
    color: var(--bone);
    font-weight: 500;
  }
  .prose :global(a) {
    color: var(--sand);
    text-decoration: underline dotted;
    text-underline-offset: 3px;
    transition: color var(--quick) var(--ease);
  }
  .prose :global(a:hover) {
    color: var(--bone);
  }
  .prose :global(code),
  .lede :global(code) {
    font: 0.74em var(--mono);
    background: var(--raised);
    padding: 1px 4px;
    border-radius: 4px;
    color: var(--bone);
    overflow-wrap: anywhere;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .prose :global(a code) {
    color: var(--sand);
    background: var(--sand-ground);
  }
  .prose :global(pre) {
    margin: 0 0 20px;
    padding: 16px 18px;
    background: var(--rail);
    border-radius: 12px;
    overflow-x: auto;
  }
  .prose :global(pre code) {
    font-size: 12.5px;
    background: none;
    border: 0;
    padding: 0;
    overflow-wrap: normal;
  }
  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 8px 0 24px;
    font-size: 13.5px;
  }
  .prose :global(th) {
    text-align: left;
    font-weight: 500;
    color: var(--dust);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0 16px 10px 0;
    border-bottom: 1px solid var(--line);
  }
  .prose :global(td) {
    padding: 11px 16px 11px 0;
    border-bottom: 1px solid var(--line);
    color: var(--parchment);
    vertical-align: top;
    line-height: 1.55;
  }
  .prose :global(td:first-child) {
    color: var(--bone);
  }
  .prose :global(td code) {
    font-size: 12px;
  }

  .sheet {
    margin: 0;
    width: min(320px, 86vw);
    height: 100vh;
    max-height: none;
    padding: 26px 16px;
    border: 0;
    border-right: 1px solid var(--line);
    background: var(--rail);
    color: var(--bone);
    transform: translateX(-100%);
    transition:
      transform var(--settle) var(--ease),
      display var(--settle) allow-discrete,
      overlay var(--settle) allow-discrete;
  }
  .sheet[open] {
    transform: none;
  }
  @starting-style {
    .sheet[open] {
      transform: translateX(-100%);
    }
  }
  .sheet::backdrop {
    background: rgb(14 13 16 / 0.6);
  }

  @media (max-width: 1100px) {
    .cols {
      grid-template-columns: 240px minmax(0, 1fr);
    }
    .right {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
    }
    .left {
      display: none;
    }
    .menu {
      display: inline-flex;
    }
    main {
      padding: 40px 22px 96px;
    }
    h1 {
      font-size: 34px;
    }
  }
  @media (max-width: 520px) {
    .find span:not(.key) {
      display: none;
    }
    .find {
      width: 32px;
      padding: 0;
      justify-content: center;
    }
    .find .key {
      display: none;
    }
    .prose :global(p),
    .prose :global(li) {
      font-size: 17px;
    }
  }
</style>
