---
// The home page: the feeling first, then the downloads, then the app itself.
import Site from '../layouts/Site.astro';
import TopBar from '../components/TopBar.astro';
import Logo from '../components/Logo.astro';
import Teaser from '../components/Teaser.astro';
import Icon from '../components/Icon.astro';

const releases = 'https://github.com/dylanpieper/mandala/releases';
// The fine print: one line when there is room, else one group per line.
const fine = ['Free · Works with .md files', 'Keep your Obsidian vault', 'No account · No network'];
---

<Site title="Mandala" description="Notes that dissolve in the sands of time, unless you turn them into stone. For a folder of markdown, such as an Obsidian vault.">
  <TopBar />
  <main>
    <Logo />
    <h1 class="serif">Every note is <em>sand</em>.<br />Keep what matters in <b>stone</b>.</h1>
    <div class="dl">
      <a class="pill stone large" href={releases}><Icon name="next" size={16} class="down" />Download for macOS</a>
      <a class="pill large" href={releases}><Icon name="next" size={16} class="down" />Download for Windows</a>
    </div>
    <p class="fine mono">{fine.map((g) => <span>{g}</span>)}</p>
    <Teaser />
  </main>
</Site>

<style>
  main {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px 24px 120px;
    background: var(--night);
  }
  h1 {
    margin: 26px 0 30px;
    font-weight: 400;
    font-size: 34px;
    line-height: 1.25;
    text-align: center;
  }
  h1 em {
    color: var(--sand);
  }
  h1 b {
    color: var(--stone);
    font-weight: 400;
    font-style: italic;
  }
  .dl {
    display: flex;
    gap: 12px;
  }
  .dl :global(.down) {
    transform: rotate(90deg);
  }
  .fine {
    margin: 16px 0 70px;
    color: var(--dust);
    font-size: 13px;
    line-height: 1.6;
    text-align: center;
  }
  .fine span {
    white-space: nowrap;
  }
  .fine span + span::before {
    content: ' · ';
    white-space: pre;
  }
  @media (max-width: 820px) {
    h1 {
      font-size: 28px;
      margin: 22px 0 26px;
    }
    .dl {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      max-width: 320px;
    }
    .dl .pill {
      justify-content: center;
    }
    .fine {
      font-size: 12.5px;
      margin-bottom: 48px;
    }
    .fine span {
      display: block;
    }
    .fine span + span::before {
      content: none;
    }
  }
  @media (max-width: 520px) {
    main {
      padding: 12px 16px 72px;
    }
    h1 {
      font-size: clamp(22px, 7.4vw, 28px);
    }
  }
</style>
